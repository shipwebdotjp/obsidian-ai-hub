# Secrets / credentials
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
TAVILY_API_KEY=<YOUR_TAVILY_API_KEY>
OPENCODE_API_KEY=<YOUR_OPENCODE_API_KEY>
OPEN_WEB_UI_API_KEY=<YOUR_OPEN_WEB_UI_API_KEY>
LINE_MESSAGING_TOKEN=<YOUR_LINE_MESSAGING_TOKEN>

# Personal / environment-specific paths
VAULT_PATH=<YOUR_OBSIDIAN_VAULT_PATH>
# Base directory for local model downloads and caches
LOCAL_MODEL_DIR=<YOUR_LOCAL_MODEL_DIRECTORY>
AI_LOG_PATH=<YOUR_AI_LOG_DIRECTORY>

# Calendar / messaging targets
GOG_CALENDAR_ID=<YOUR_GOOGLE_CALENDAR_ID>
LINE_TARGET_ID=<YOUR_LINE_TARGET_ID>
# Optional legacy fallback used by some scripts
# CALENDAR_ID=<YOUR_GOOGLE_CALENDAR_ID>

# Optional external tool defaults
OPEN_WEB_UI_BASE_URL=http://localhost:8080
RESEARCH_ROUTER_MODEL=gpt-5.4
RESEARCH_ROUTER_TEMPERATURE=0.0
RESEARCH_ROUTER_MAX_TOKENS=16
RESEARCH_PROMPT_MODEL=gpt-5.4
RESEARCH_PROMPT_TEMPERATURE=0.2
RESEARCH_PROMPT_MAX_TOKENS=8000
RESEARCH_SMART_MODEL=gpt-5.4
RESEARCH_DEFAULT_OUTPUT_STYLE=long
RESEARCH_CONTEXT_LOOKBACK_DAYS=7
RESEARCH_CONTEXT_MAX_NOTES=3

# Optional Vault index overrides
# VAULT_INDEX_SQLITE_PATH=<YOUR_VAULT_INDEX_SQLITE_PATH>
# VAULT_INDEX_CHROMA_PATH=<YOUR_VAULT_INDEX_CHROMA_PATH>

# Optional environment helpers used by local tooling
# SENTENCE_TRANSFORMERS_HOME=<YOUR_SENTENCE_TRANSFORMERS_HOME>
# HUGGINGFACE_API_KEY=<YOUR_HUGGINGFACE_API_KEY>
