# Secrets / credentials
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
TAVILY_API_KEY=<YOUR_TAVILY_API_KEY>
OPENCODE_API_KEY=<YOUR_OPENCODE_API_KEY>
# Optional default session identifier sent as x-opencode-session to OpenCode Go when no conversation session ID is specified (default: obsidian-ai-hub)
# OPENCODE_SESSION_ID=obsidian-ai-hub
OPEN_WEB_UI_API_KEY=<YOUR_OPEN_WEB_UI_API_KEY>
LINE_MESSAGING_TOKEN=<YOUR_LINE_MESSAGING_TOKEN>
LINE_CHANNEL_SECRET=<YOUR_LINE_CHANNEL_SECRET>
LINE_ALLOWED_USER_IDS=<YOUR_LINE_ALLOWED_USER_IDS>
OBSIDIAN_AI_HUB_API_TOKEN=<YOUR_OBSIDIAN_AI_HUB_API_TOKEN>

# Personal / environment-specific paths
VAULT_PATH=<YOUR_OBSIDIAN_VAULT_PATH>
# Base directory for local model downloads and caches
LOCAL_MODEL_DIR=<YOUR_LOCAL_MODEL_DIRECTORY>
AI_LOG_PATH=<YOUR_AI_LOG_DIRECTORY>

# Calendar / messaging targets
APPLE_CALENDAR_NAME=<YOUR_CALENDAR_TITLE_IN_CALENDAR_APP>
LINE_TARGET_ID=<YOUR_LINE_TARGET_ID>

# Public base URL for the Web UI / API, used as the base for LINE notification
OBSIDIAN_AI_HUB_WEB_URL=<YOUR_OBSIDIAN_AI_HUB_WEB_URL>

# Optional external tool defaults
OPEN_WEB_UI_BASE_URL=http://localhost:8080

# Optional Vault index overrides
# VAULT_INDEX_SQLITE_PATH=<YOUR_VAULT_INDEX_SQLITE_PATH>
# VAULT_INDEX_CHROMA_PATH=<YOUR_VAULT_INDEX_CHROMA_PATH>

# Optional environment helpers used by local tooling
# SENTENCE_TRANSFORMERS_HOME=<YOUR_SENTENCE_TRANSFORMERS_HOME>
# HUGGINGFACE_API_KEY=<YOUR_HUGGINGFACE_API_KEY>

# Optional coding workspace overrides (override config/config.yml if set)
# CODING_ORCHESTRATOR_PROVIDER=openai
# CODING_ORCHESTRATOR_MODEL=gpt-5.6-terra
# CODING_OPENCODE_CLI_PATH=/path/to/your/opencode (ACP agent executable)
# CODING_OPENCODE_MODEL=opencode-go/muse-spark-1.3-contributor

# Optional image generation overrides (override config/config.yml if set)
# IMAGE_GENERATION_OUTPUT_DIR=<YOUR_IMAGE_OUTPUT_DIRECTORY>
# IMAGE_GENERATION_INPUT_DIR=<YOUR_IMAGE_INPUT_DIRECTORY>
# IMAGE_GENERATION_MODEL=gpt-image-2.5-sunburst
# IMAGE_GENERATION_DEFAULT_SIZE=1024x1024
# IMAGE_GENERATION_DEFAULT_QUALITY=low
# IMAGE_GENERATION_MAX_COUNT=4
# IMAGE_GENERATION_MAX_INPUT_BYTES=8388608
# IMAGE_GENERATION_LOCK_LLM_QUALITY=true
# IMAGE_GENERATION_LLM_QUALITY=low
