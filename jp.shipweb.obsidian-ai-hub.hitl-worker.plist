<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>jp.shipweb.obsidian-ai-hub.hitl-worker</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{PWD}}/.venv/bin/python3</string>
        <string>-m</string>
        <string>obsidian_ai_hub</string>
        <string>--hitl-worker</string>
    </array>

    <key>WorkingDirectory</key>
    <string>{{PWD}}</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ExitTimeOut</key>
    <integer>360</integer>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/tmp/obsidian_hitl_worker.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/obsidian_hitl_worker.err</string>
</dict>
</plist>
